import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3
from datetime import datetime 

class ModernTodoApp:
    def __init__(self, root):
        self.root=root
        self.root.title("My Tasks")
        self.root.geometry("800x600")
        self.root.configure(bg='#bb85ab')
        self.setup_database()
        self.create_widgets()

    def setup_database(self):
        self.conn=sqlite3.connect('tasks.db')
        self.cursor = self.conn.cursor()
        self.cursor.execute('''CREATE TABLE IF NOT EXISTS tasks
                            (id INTEGER PRIMARY KEY AUTOINCREMENT,
                            title TEXT NOT NULL,
                            description TEXT,
                            due_date TEXT, priority TEXT, status TEXT DEFAULT 'pending', created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                            completed BOOLEAN DEFAULT 0)''')
        self.conn.commit()

    def create_widgets(self):
        header = tk.Frame(self.root, bg='#ffe5b4', height=80)
        header.pack(fill=tk.X)
        header.pack_propagate(False)
        tk.Label(header, text="Task Manager", font=('Comic Sans MS', 20, 'bold'),bg='#2c3e50', fg='white').pack(pady=15)

        main_container=tk.Frame(self.root, bg='#f0f0f0')
        main_container.pack(fill=tk.BOTH, expand =True, padx=20, pady=20)

        input_frame = tk.Frame(main_container, bg = '#ffa500', relief =tk.RAISED, bd=1)
        input_frame.pack(fill=tk.X, pady=(0,15))

        tk.Label(input_frame, text="Task Title:", font=('Comic Sans MS', 10, 'bold'), bg="#BF6FEA").grid(row=0, column=0, padx=10, pady=10, sticky='w')
        self.title_entry=tk.Entry(input_frame, font=('Comic Sans MS', 11), width=30)
        self.title_entry.grid(row=0, column = 1, padx=10, pady=10)

        tk.Label(input_frame, text="Priority", font=('Comic Sans MS', 10, 'bold'), bg='white').grid(row=0, column=2, padx=10, pady=10)
        self.priority_var=tk.StringVar(value="Medium")
        priority_menu=ttk.Combobox(input_frame, textvariable=self.priority_var, values=['High', 'Medium', 'Low'], width=10)
        priority_menu.grid(row=0, column=3, padx=10, pady=10)

        tk.Button(input_frame, text="Add Task", command=self.add_task, bg='#27ae60', fg='white', font=('Comic Sans MS', 10, 'bold'), padx=20, pady=5).grid(row=0, column=4, padx=10, pady=10)

        list_frame = tk.Frame(main_container, bg='white', relief=tk.RAISED, bd=1)
        list_frame.pack(fill=tk.BOTH, expand=True)
        columns=('ID', 'Title', 'Priority', 'Status', 'Created')
        self.task_tree=ttk.Treeview(list_frame, columns=columns, show='headings', height=15)
        self.task_tree.heading('ID', text='ID')
        self.task_tree.heading('Title', text='Task')
        self.task_tree.heading('Priority', text='Priority')
        self.task_tree.heading('Status', text='Status')
        self.task_tree.heading('Created', text='Created')
        self.task_tree.column('ID', width=40)
        self.task_tree.column('Title', width=250)
        self.task_tree.column('Priority', width=100)
        self.task_tree.column('Status', width=100)
        self.task_tree.column('Created', width=150)

        scrollbar=ttk.Scrollbar(list_frame, orient=tk.VERTICAL, command=self.task_tree.yview)
        self.task_tree.configure(yscrollcommand=scrollbar.set)
        self.task_tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        button_frame=tk.Frame(main_container, bg='#f0f0f0')
        button_frame.pack(fill=tk.X, pady=(10,0))

        tk.Button(button_frame, text='Complete', command=self.complete_task, bg='#3498db', fg='white', font=('Comic Sans MS', 10, 'bold'), padx=15, pady=5).pack(side=tk.LEFT, padx=5)
        tk.Button(button_frame, text='Delete', command=self.delete_task, bg='#e74c3c', fg='white', font=('Comic Sans MS', 10, 'bold'), padx=15, pady=5).pack(side=tk.LEFT, padx=5)


    def add_task(self):
        title=self.title_entry.get().strip()
        if not title:
            messagebox.showwarning("Warning", "Please enter a task title!")
            return
        priority=self.priority_var.get()
        self.cursor.execute(''' INSERT INTO tasks (title, priority) VALUES(?,?)''', (title, priority))
        self.conn.commit()
        self.title_entry.delete(0, tk.END)
        self.load_tasks()
        messagebox.showinfo("Success", "Task added successfully!")

    def load_tasks(self):
        for item in self.task_tree.get_children():
            self.task_tree.delete(item)
        self.cursor.execute('''SELECT id, title, priority, status, strftime('%Y-%m-%d %H:%M', created_at)FROM tasks ORDER BY CASE priority WHEN 'High' THEN 1 WHEN 'Medium' THEN 2 WHEN 'Low' THEN 3 END, created_at DESC''')

        for task in self.cursor.fetchall():
            tags=()
            if task[2] =='High':
                tags=('high',)
            elif task[2] == 'Medium':
                tags=('medium',)

            self.task_tree.insert('', tk.END, values=task, tags=tags)

        self.task_tree.tag_configure('high', background='#ffcccc')
        self.task_tree.tag_configure('medium', background='#ffffcc')
        self.task_tree.tag_configure('low', background='#ccffcc')

    def complete_task(self):
        selected=self.task_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Please select a task!")
            return
        task_id=self.task_tree.item(selected[0])['values'][0]
        self.cursor.execute(''' UPDATE tasks SET status = 'completed' WHERE id =? ''', (task_id,))
        self.conn.commit()
        self.load_tasks()

    def delete_task(self):
        selected = self.task_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Please select a task!")
            return
        if messagebox.askyesno("Confirm Delete", "Delete this task?"):
            task_id=self.task_tree.item(selected[0])['values'][0]
            self.cursor.execute('DELETE FROM tasks WHERE id =?', (task_id,))
            self.conn.commit()
            self.load_tasks()

    def show_stats(self):
        self.cursor.execute('''SELECT COUNT(*) as total, SUM(CASE WHEN status='completed' THEN 1 ELSE 0 END) as done,SUM(CASE WHEN priority='High' THEN 1 ELSE 0 END)as high FROM tasks ''')
        total, done,high=self.cursor.fetchone()

        stats=f""" 
         Total Tasks :{total}
         Completed : {done}
         Pending : {total - done}
         High Priority : {high}
         Completion Rate : {round((done/total*100)if total>0 else 0)}%"""
        messagebox.showinfo("Statistics", stats)

    def __del__(self):
        if hasattr(self,'conn'):
            self.conn.close()

if __name__=="__main__":
    root=tk.Tk()
    app=ModernTodoApp(root)
    root.mainloop()

